
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Página inicial: /index.html vira /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Remover .html dos endereços públicos
  RewriteCond %{THE_REQUEST} \s/+(servicos|quem-somos|contato)\.html[\s?] [NC]
  RewriteRule ^(servicos|quem-somos|contato)\.html$ /$1 [R=301,L]

  # Remover a barra final nas páginas internas
  RewriteRule ^(servicos|quem-somos|contato)/$ /$1 [R=301,L]

  # Carregar os arquivos HTML internamente
  RewriteRule ^(servicos|quem-somos|contato)$ $1.html [L]
</IfModule>
